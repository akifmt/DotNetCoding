		<PackageReference Include="Microsoft.FluentUI.AspNetCore.Components.Emoji" Version="4.14.4" />
		<PackageReference Include="Mapster" Version="10.0.12" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.11" />
		<PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="10.0.11" />
		<PackageReference Include="System.Linq.Dynamic.Core" Version="1.7.3" />
	</ItemGroup>
</Project>
